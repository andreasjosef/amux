#!/bin/bash

SESSION_NAME=$(basename "$PWD" | tr . _)

# Layout: `amux` opens CLAUDE/NVIM/TERM/SERVER; `amux old` opens the original
# SHAPE/BUILD/INSPECT/SERVER layout.
LAYOUT=${1:-new}
if [ "$LAYOUT" = old ]; then W0=SHAPE W1=BUILD W2=INSPECT; else W0=CLAUDE W1=NVIM W2=TERM; fi

# Windows are addressed by name (`session:=NAME`) and created without an index, so the
# layout works whatever the user's tmux base-index is (0 or 1).
win() { echo "$SESSION_NAME:=$1"; }

# Check if session already exists
tmux has-session -t "$SESSION_NAME" 2>/dev/null
if [ $? -eq 0 ]; then
    tmux attach-session -t "$SESSION_NAME"
    exit 0
fi

# 0. Create session with the first window (Claude, auto mode; SHAPE in the old layout)
#
# tmux's global environment is captured once, when its server process is born, from
# whatever process first talked to that socket -- not refreshed per new-session call.
# If a stale server is still running from an earlier sandboxed invocation (e.g. an
# opencode HOME override), every session created here would silently inherit that
# frozen HOME, so tools like claude would read config from the wrong home and replay
# onboarding. Pin HOME explicitly so this session is correct regardless of server
# history; set-environment propagates it to the windows created below too.
tmux new-session -d -s "$SESSION_NAME" -n "$W0" -e HOME="$HOME"
tmux set-environment -t "$SESSION_NAME" HOME "$HOME"
sleep 0.3
tmux send-keys -t "$(win "$W0")" "claude --permission-mode auto" C-m

if [ "$LAYOUT" = old ]; then
    # 1. Create Build (implement with opencode)
    tmux new-window -t "$SESSION_NAME:" -n 'BUILD'
    sleep 0.3
    tmux send-keys -t "$(win BUILD)" "opencode" C-m

    # 2. Create Inspect (plain shell for inspecting code)
    tmux new-window -t "$SESSION_NAME:" -n 'INSPECT'
else
    # 1. Create Nvim (edit and browse code)
    tmux new-window -t "$SESSION_NAME:" -n 'NVIM'
    sleep 0.3
    tmux send-keys -t "$(win NVIM)" "nvim ." C-m

    # 2. Create Term (plain shell)
    tmux new-window -t "$SESSION_NAME:" -n 'TERM'
fi

# 3. Create Server (dev server)
tmux new-window -t "$SESSION_NAME:" -n 'SERVER'
sleep 0.3
tmux send-keys -t "$(win SERVER)" "pnpm dev" C-m

# 4. Create LGIT (lazygit, open from the start; M-o toggles to it below)
tmux new-window -t "$SESSION_NAME:" -n 'LGIT'
sleep 0.3
tmux send-keys -t "$(win LGIT)" "lazygit" C-m

# 5. Register M-. to gracefully close this workspace. Unprefixed (root table), the
#    same way the M-j/M-k/M-l navigation keys are, and set by the script so it
#    ships with the tool (no ~/.tmux.conf edit). Confirm-before names the session;
#    declining leaves it untouched.
tmux bind-key -n 'M-.' confirm-before -p "kill session $SESSION_NAME? (y/n)" \
  "run-shell 'tmux send-keys -t $(win "$W0") C-c; tmux send-keys -t $(win "$W1") C-c; tmux send-keys -t $(win "$W2") C-c; tmux send-keys -t $(win SERVER) C-c; sleep 1; tmux kill-session -t ${SESSION_NAME}'"

# 6. Register tool windows, each toggled by one key: from anywhere the key jumps to the
#    window (creating it in the current pane's directory if missing), from the window it
#    goes back to the previous one. A window created by the key closes when its tool quits.
bind_toggle() { # KEY NAME COMMAND...
  local key=$1 name=$2; shift 2
  tmux bind-key -n "$key" if-shell -F "#{==:#{window_name},$name}" 'last-window' \
    "if-shell -F '#{W:#{?#{==:#{window_name},$name},1,}}' 'select-window -t :=$name' 'new-window -n $name -c \"#{pane_current_path}\" $*'"
}
#    M-s: the dev server (SERVER).
bind_toggle 'M-s' SERVER pnpm dev
#    M-o: lazygit (LGIT). Its `e` opens files in Neovim (see the nvim config's
#    bin/lazygit-edit), so Neovim <-> LGIT is one key each way.
bind_toggle 'M-o' LGIT lazygit
#    M-p: gh-dash (`gh extension install dlvhdr/gh-dash`), the repo's PRs and issues.
bind_toggle 'M-p' PRS gh dash

# 7. Pipeline status: prefix this session's status-right (keeping the global one after
#    it) with the default branch's CI and deploy marks. M-c toggles the session between
#    that and the current branch's marks. amux is symlinked into ~/.local/bin, so the
#    helper script is found next to the real file.
AMUX_DIR=$(dirname "$(readlink -f "$0")")
tmux set-option -t "$SESSION_NAME" status-right \
  "#($AMUX_DIR/amux-pipeline-status '$PWD' #{@pipeline-view})$(tmux show-options -gv status-right)"
tmux set-option -t "$SESSION_NAME" status-right-length \
  $(( $(tmux show-options -gv status-right-length) + 100 ))
tmux bind-key -n 'M-c' if-shell -F '#{==:#{@pipeline-view},branch}' \
  'set-option @pipeline-view default ; refresh-client -S' \
  'set-option @pipeline-view branch ; refresh-client -S'

# Attach and focus the first window
tmux select-window -t "$(win "$W0")"
tmux attach-session -t "$SESSION_NAME"
