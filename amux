#!/bin/bash

SESSION_NAME=$(basename "$PWD" | tr . _)

# Layout: `amux` opens CLAUDE/NVIM/TERM/SERVER; `amux old` opens the original
# SHAPE/BUILD/INSPECT/SERVER layout.
LAYOUT=${1:-new}
if [ "$LAYOUT" = old ]; then W0=SHAPE; else W0=CLAUDE; fi

# Check if session already exists
tmux has-session -t "$SESSION_NAME" 2>/dev/null
if [ $? -eq 0 ]; then
    tmux attach-session -t "$SESSION_NAME"
    exit 0
fi

# 0. Create session with Window 0 (Claude, auto mode; SHAPE in the old layout)
#
# tmux's global environment is captured once, when its server process is born, from
# whatever process first talked to that socket -- not refreshed per new-session call.
# If a stale server is still running from an earlier sandboxed invocation (e.g. an
# opencode HOME override), every session created here would silently inherit that
# frozen HOME, so tools like claude would read config from the wrong home and replay
# onboarding. Pin HOME explicitly so this session is correct regardless of server
# history; set-environment propagates it to the windows created below too.
tmux new-session -d -s "$SESSION_NAME" -n "$W0" -e HOME="$HOME"
tmux set-environment -t "$SESSION_NAME" HOME "$HOME"
sleep 0.3
tmux send-keys -t "$SESSION_NAME:0" "claude --permission-mode auto" C-m

if [ "$LAYOUT" = old ]; then
    # 1. Create Window 1 (Build: implement with opencode)
    tmux new-window -t "$SESSION_NAME:1" -n 'BUILD'
    sleep 0.3
    tmux send-keys -t "$SESSION_NAME:1" "opencode" C-m

    # 2. Create Window 2 (Inspect: plain shell for inspecting code)
    tmux new-window -t "$SESSION_NAME:2" -n 'INSPECT'
else
    # 1. Create Window 1 (Nvim: edit and browse code)
    tmux new-window -t "$SESSION_NAME:1" -n 'NVIM'
    sleep 0.3
    tmux send-keys -t "$SESSION_NAME:1" "nvim" C-m

    # 2. Create Window 2 (Term: plain shell)
    tmux new-window -t "$SESSION_NAME:2" -n 'TERM'
fi

# 3. Create Window 3 (Server: dev server)
tmux new-window -t "$SESSION_NAME:3" -n 'SERVER'
sleep 0.3
tmux send-keys -t "$SESSION_NAME:3" "pnpm dev" C-m

# 4. Register M-. to gracefully close this workspace. Unprefixed (root table), the
#    same way the M-j/M-k/M-l/M-; navigation keys are, and set by the script so it
#    ships with the tool (no ~/.tmux.conf edit). Confirm-before names the session;
#    declining leaves it untouched.
tmux bind-key -n 'M-.' confirm-before -p "kill session $SESSION_NAME? (y/n)" \
  "run-shell 'tmux send-keys -t ${SESSION_NAME}:0 C-c; tmux send-keys -t ${SESSION_NAME}:1 C-c; tmux send-keys -t ${SESSION_NAME}:2 C-c; tmux send-keys -t ${SESSION_NAME}:3 C-c; sleep 1; tmux kill-session -t ${SESSION_NAME}'"

# 5. Register on-demand tool windows, each toggled by one key: from anywhere the key
#    jumps to the window (creating it in the current pane's directory if missing), from
#    the window it goes back to the previous one. Quitting the tool closes the window.
bind_toggle() { # KEY NAME COMMAND...
  local key=$1 name=$2; shift 2
  tmux bind-key -n "$key" if-shell -F "#{==:#{window_name},$name}" 'last-window' \
    "if-shell -F '#{W:#{?#{==:#{window_name},$name},1,}}' 'select-window -t :=$name' 'new-window -n $name -c \"#{pane_current_path}\" $*'"
}
#    M-o: lazygit. Its `e` opens files in Inspect's Neovim (see the nvim config's
#    bin/lazygit-edit), so Inspect <-> LGIT is one key each way.
bind_toggle 'M-o' LGIT lazygit
#    M-p: gh-dash (`gh extension install dlvhdr/gh-dash`), the repo's PRs and issues.
bind_toggle 'M-p' PRS gh dash

# 6. Pipeline status: prefix this session's status-right (keeping the global one after
#    it) with the default branch's CI and deploy marks. M-c toggles the session between
#    that and the current branch's marks. amux is symlinked into ~/.local/bin, so the
#    helper script is found next to the real file.
AMUX_DIR=$(dirname "$(readlink -f "$0")")
tmux set-option -t "$SESSION_NAME" status-right \
  "#($AMUX_DIR/amux-pipeline-status '$PWD' #{@pipeline-view})$(tmux show-options -gv status-right)"
tmux set-option -t "$SESSION_NAME" status-right-length \
  $(( $(tmux show-options -gv status-right-length) + 100 ))
tmux bind-key -n 'M-c' if-shell -F '#{==:#{@pipeline-view},branch}' \
  'set-option @pipeline-view default ; refresh-client -S' \
  'set-option @pipeline-view branch ; refresh-client -S'

# Attach and focus window 0
tmux select-window -t "$SESSION_NAME:0"
tmux attach-session -t "$SESSION_NAME"
